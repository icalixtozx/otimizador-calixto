<UserControl x:Class="Optimizer.App.Views.NetworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Canvas}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="34,28,34,31">
      <Grid Margin="0,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Diagnóstico de rede" FontSize="27" FontWeight="Bold" />
          <TextBlock Text="Consulte a configuração local e teste um destino identificado, sob demanda." FontSize="12" Foreground="#737373" Margin="0,7,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource QuietButton}" Command="{Binding LoadAdaptersCommand}" IsEnabled="{Binding IsIdle}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="↻" FontSize="16" Margin="0,0,6,0" />
            <TextBlock Text="Atualizar adaptadores" />
          </StackPanel>
        </Button>
      </Grid>

      <Border Style="{StaticResource CardBorder}" Padding="15,12" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding WarningMessage}" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" FontSize="10" Foreground="#8A4B16" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <TextBlock Text="Adaptadores e configuração local" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />
      <ItemsControl ItemsSource="{Binding Adapters}" Margin="0,0,0,8">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <Border Grid.Column="1" Background="#F0F0EE" CornerRadius="6" Padding="7,3">
                      <TextBlock Text="{Binding State}" FontSize="9" FontWeight="Bold" />
                    </Border>
                  </Grid>
                  <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#777777" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding LinkSpeed}" FontSize="10" Foreground="#444444" Margin="0,7,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="ENDEREÇOS" FontSize="9" FontWeight="Bold" Foreground="#777777" />
                  <TextBlock Text="{Binding Addresses}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,6" />
                  <TextBlock Text="GATEWAYS" FontSize="9" FontWeight="Bold" Foreground="#777777" />
                  <TextBlock Text="{Binding Gateways}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,6" />
                  <TextBlock Text="DNS CONFIGURADOS" FontSize="9" FontWeight="Bold" Foreground="#777777" />
                  <TextBlock Text="{Binding DnsServers}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Background="#F1F1EF" CornerRadius="8" Padding="12" Margin="0,0,0,18"
              Visibility="{Binding HasNoAdapters, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="Nenhum adaptador exibido ainda. Atualize para fazer a leitura local." FontSize="10" Foreground="#6E6E6E" />
      </Border>
      <TextBlock Text="A velocidade é a informada pelo adaptador para o enlace local; não representa velocidade contratada nem medida da internet." FontSize="10" Foreground="#777777" TextWrapping="Wrap" Margin="0,0,0,22" />

      <Border Style="{StaticResource CardBorder}" Padding="20">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
            <Ellipse Width="7" Height="7" Fill="#111111" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Text="TESTE ATIVO · SOMENTE SOB DEMANDA" FontSize="10" FontWeight="Bold" />
          </StackPanel>
          <TextBlock Text="Destino e finalidade" FontSize="18" FontWeight="Bold" Margin="0,4,0,11" />
          <TextBlock Text="{Binding DestinationPreview}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,7" />
          <TextBlock Text="Finalidade: resolver o nome (quando aplicável) e enviar até 4 pequenas sondagens ICMP ao IP resolvido. Cada sondagem aguarda até 1.000 ms; a duração total inclui resolução e sondagens. Isso mede RTT/respostas desse destino, não velocidade nem acesso geral à internet." FontSize="11" Foreground="#666666" TextWrapping="Wrap" Margin="0,0,0,12" />
          <TextBlock Text="Resolução DNS e sondagens ICMP podem enviar tráfego. Nenhum tráfego é enviado até você clicar em Iniciar teste." FontSize="10" Foreground="#8A4B16" TextWrapping="Wrap" Margin="0,0,0,10" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" Padding="10,8" FontSize="12" VerticalContentAlignment="Center" Margin="0,0,9,0" ToolTip="Host ou endereço IP, sem URL, caminho ou porta" />
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Command="{Binding TestConnectivityCommand}" IsEnabled="{Binding CanTest}" Margin="0,0,8,0">
              <TextBlock Text="Iniciar teste" Foreground="White" />
            </Button>
            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Command="{Binding CancelTestCommand}" Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="Cancelar" />
            </Button>
          </Grid>
          <TextBlock Text="{Binding ProgressMessage}" FontSize="10" Foreground="#666666" Margin="0,9,0,0" />
          <Border Background="#F5F5F3" CornerRadius="9" Padding="13" Margin="0,13,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="{Binding OutcomeLabel}" FontSize="9" FontWeight="Bold" Foreground="#555555" />
              <TextBlock Text="{Binding ResultSummary}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0" />
              <TextBlock Text="{Binding ResultMetadata}" FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" />
              <TextBlock Text="{Binding RoundtripSummary}" FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0" />
              <TextBlock Text="{Binding ResultDetails}" FontSize="10" Foreground="#777777" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
