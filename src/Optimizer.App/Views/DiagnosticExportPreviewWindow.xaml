<Window x:Class="Optimizer.App.Views.DiagnosticExportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revisar relatório diagnóstico" Width="920" Height="690"
        MinWidth="680" MinHeight="480" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Background="#F7F7F5" FontFamily="Segoe UI">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="*" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Relatório diagnóstico sanitizado" FontSize="20" FontWeight="Bold" />
      <TextBlock Text="Confira o conteúdo antes de salvar. O arquivo não é enviado automaticamente." FontSize="11" Foreground="#666666" Margin="0,6,0,0" />
      <TextBlock Text="IDs PnP, GUIDs de planos, nome da conta/computador, números de série, endereços de rede e caminhos locais foram omitidos." FontSize="10" Foreground="#777777" TextWrapping="Wrap" Margin="0,5,0,0" />
    </StackPanel>
    <TextBox x:Name="ReportText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True"
             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
             FontFamily="Consolas" FontSize="10" Background="White" BorderBrush="#DDDDDA"
             BorderThickness="1" Padding="12" />
    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock x:Name="FeedbackText" FontSize="10" Foreground="#666666" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button Grid.Column="1" Content="Fechar" MinWidth="90" Margin="0,0,8,0" Padding="14,8" Click="Close_Click" />
      <Button Grid.Column="2" Content="Salvar JSON…" MinWidth="125" Padding="14,8" Background="#111111" Foreground="White" BorderBrush="#111111" Click="Save_Click" />
    </Grid>
  </Grid>
</Window>
