<UserControl x:Class="Optimizer.App.Views.DriversPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Canvas}">
  <Grid Margin="34,28,34,31">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="17" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Identificador de drivers" FontSize="27" FontWeight="Bold" />
        <TextBlock Text="Veja o que o Windows reporta sobre dispositivos e drivers instalados." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,7,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource QuietButton}" Command="{Binding ToggleCandidateReviewCommand}" Margin="0,0,9,0">
          <TextBlock Text="{Binding CandidateReviewButtonLabel}" />
        </Button>
        <Button Style="{StaticResource QuietButton}" Command="{Binding ReloadCommand}" IsEnabled="{Binding IsNotLoading}" Margin="0,0,9,0">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="↻" FontSize="16" Margin="0,0,6,0" />
            <TextBlock Text="Atualizar" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="↓" FontSize="16" Foreground="White" Margin="0,0,6,0" />
            <TextBlock Text="Exportar CSV" Foreground="White" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="15,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="28" Height="28" CornerRadius="8" Background="#F0F0EE" VerticalAlignment="Center">
          <TextBlock Text="i" FontFamily="Georgia" FontStyle="Italic" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0,9,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CollectedAtLabel}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
          <TextBlock Text="Códigos PnP são valores informados pelo Windows; um código não prova, sozinho, que falta um driver. A versão/data também não é comparada a um catálogo externo." FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>
        <ProgressBar Grid.Column="2" Width="55" Height="3" IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Grid Grid.Row="4" Visibility="{Binding ShowInventoryFilters, Converter={StaticResource BoolToVisibility}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{Binding DriverCountLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#555555" />
        <TextBlock Text="  ·  O CSV omite IDs PnP" FontSize="10" Foreground="{StaticResource Muted}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="11,0" Margin="0,0,9,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="125" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="⌕" FontSize="18" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,5,0" />
            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     BorderThickness="0" Background="Transparent" FontSize="11" Padding="0,8"
                     VerticalContentAlignment="Center" ToolTip="Buscar por dispositivo, fornecedor, versão ou INF" />
            <TextBlock Grid.Column="2" Text="×" FontSize="15" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <ComboBox ItemsSource="{Binding FilterOptions}" SelectedItem="{Binding SelectedFilter}"
                  Width="165" Height="36" FontSize="11" Padding="8,5"
                  Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1"
                  DisplayMemberPath="Label" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="6" Style="{StaticResource CardBorder}" Padding="0" ClipToBounds="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0" ItemsSource="{Binding FilteredDrivers}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  CanUserDeleteRows="False" CanUserReorderColumns="True" CanUserResizeRows="False"
                  GridLinesVisibility="None" HeadersVisibility="Column" RowHeight="47"
                  Background="White" BorderThickness="0" RowBackground="White" AlternatingRowBackground="#FCFCFB"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                  Visibility="{Binding ShowInventoryGrid, Converter={StaticResource BoolToVisibility}}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="DISPOSITIVO" Binding="{Binding DeviceName}" Width="2.2*" />
            <DataGridTextColumn Header="FORNECEDOR" Binding="{Binding Provider, TargetNullValue=—}" Width="1.5*" />
            <DataGridTextColumn Header="VERSÃO" Binding="{Binding Version, TargetNullValue=—}" Width="1.2*" />
            <DataGridTextColumn Header="DATA INFORMADA" Binding="{Binding DriverDateRaw, TargetNullValue=—}" Width="1.3*" />
            <DataGridTextColumn Header="INF" Binding="{Binding InfName, TargetNullValue=—}" Width="1.1*" />
            <DataGridTemplateColumn Header="DADOS DO DRIVER" Width="1.35*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <Border CornerRadius="6" Padding="8,4" HorizontalAlignment="Left"
                          Background="{Binding IsSigned, Converter={StaticResource SignatureBackgroundConverter}}">
                    <TextBlock Text="{Binding DriverDetailsStatus}" FontSize="10" FontWeight="SemiBold"
                               Foreground="{Binding IsSigned, Converter={StaticResource SignatureForegroundConverter}}" />
                  </Border>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="ESTADO PnP" Width="1*">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding ProblemCodeLabel}" FontSize="10"
                             Foreground="{Binding ProblemCode, Converter={StaticResource ProblemForegroundConverter}}" VerticalAlignment="Center" />
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
          <ProgressBar Width="180" Height="3" IsIndeterminate="True" HorizontalAlignment="Center" />
          <TextBlock Text="Consultando o inventário local…" Foreground="#666666" FontSize="12" Margin="0,17,0,0" HorizontalAlignment="Center" />
          <TextBlock Text="A janela continua responsiva durante a leitura." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390"
                    Visibility="{Binding ShowInventoryError, Converter={StaticResource BoolToVisibility}}">
          <Border Width="42" Height="42" Background="#F4F4F2" CornerRadius="12" HorizontalAlignment="Center">
            <TextBlock Text="!" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Não foi possível ler os drivers" FontSize="15" FontWeight="Bold" Margin="0,15,0,0" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0" />
          <Button Style="{StaticResource QuietButton}" Command="{Binding ReloadCommand}" Margin="0,16,0,0" HorizontalAlignment="Center">
            <TextBlock Text="Tentar novamente" />
          </Button>
        </StackPanel>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400"
                    Visibility="{Binding ShowInventoryNoMatches, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="Nenhum driver corresponde à busca" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" />
          <TextBlock Text="Tente outro termo ou altere o filtro de assinatura." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,7,0,0" HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400"
                    Visibility="{Binding ShowInventoryEmptyState, Converter={StaticResource BoolToVisibility}}">
          <Border Width="42" Height="42" Background="#F4F4F2" CornerRadius="12" HorizontalAlignment="Center">
            <TextBlock Text="▦" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Nenhum driver retornado" FontSize="15" FontWeight="Bold" Margin="0,15,0,0" HorizontalAlignment="Center" />
          <TextBlock Text="A consulta respondeu sem itens. Isso é diferente de uma falha de leitura." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,0" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="13,9"
                Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding StatusMessage}" FontSize="10" Foreground="#6B6B6B" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="13,9"
                Visibility="{Binding ExportFeedback, Converter={StaticResource StringToVisibilityConverter}}">
          <TextBlock Text="{Binding ExportFeedback}" FontSize="10" Foreground="#6B6B6B" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer Grid.Row="0" Padding="14" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding ShowCandidateReview, Converter={StaticResource BoolToVisibility}}">
          <StackPanel>
            <Border Background="#F5F5F3" CornerRadius="9" Padding="14" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Candidatos ASUS revisados" FontSize="14" FontWeight="Bold" />
                <TextBlock Text="A avaliação usa o inventário Plug and Play local e os arquivos revisados nesta etapa. Ela não compara versões para declarar driver desatualizado e não instala nada." FontSize="10" Foreground="#686868" TextWrapping="Wrap" Margin="0,5,0,0" />
                <TextBlock Text="Etapas distintas: análise e prévia são somente leitura; staging adicionaria o pacote ao Driver Store da máquina; a associação usa DiInstallDevice para um devnode e um driver selecionados, somente se for o candidato compatível de melhor rank. O INF ainda pode trazer efeitos adicionais. Staging e associação continuam bloqueados." FontSize="10" FontWeight="SemiBold" Foreground="#5A4A2A" TextWrapping="Wrap" Margin="0,5,0,0" />
                <TextBlock Text="{Binding CandidateInventoryStatus}" FontSize="10" FontWeight="SemiBold" Foreground="#444444" TextWrapping="Wrap" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Style="{StaticResource QuietButton}" Command="{Binding ImportLocalPackageCommand}" IsEnabled="{Binding IsNotLoading}">
                    <TextBlock Text="Analisar INF/ZIP local (sem executar)" />
                  </Button>
                  <ProgressBar Width="70" Height="3" IsIndeterminate="True" Margin="12,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding IsImportingPackage, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Text="{Binding PackageImportFeedback}" FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding HasPackageImportFeedback, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding CandidateReviews}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding Candidate.DeviceLabel}" FontSize="14" FontWeight="Bold" />
                          <TextBlock Text="{Binding Candidate.Chipset}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#F0F0EE" CornerRadius="6" Padding="8,5" VerticalAlignment="Center">
                          <TextBlock Text="{Binding CandidateStatus}" FontSize="9" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="250" />
                        </Border>
                      </Grid>

                      <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="20" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#FAFAF9" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="11">
                          <StackPanel>
                            <TextBlock Text="PACOTE INFORMADO PELO WINDOWS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                            <TextBlock Text="{Binding InstalledPackageSummary}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" />
                          </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#FAFAF9" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="11">
                          <StackPanel>
                            <TextBlock Text="CANDIDATO DA ASUS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                            <TextBlock Text="{Binding Candidate.PackageTitle}" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,0" />
                            <TextBlock FontSize="10" Foreground="#555555" Margin="0,3,0,0">
                              <Run Text="Versão " /><Run Text="{Binding Candidate.Version}" /><Run Text=" · publicado em " /><Run Text="{Binding Candidate.PublishedDate}" />
                            </TextBlock>
                            <TextBlock FontSize="10" Foreground="#555555" Margin="0,3,0,0">
                              <Run Text="Alvo: " /><Run Text="{Binding Candidate.TargetOperatingSystems}" />
                            </TextBlock>
                            <Button Style="{StaticResource QuietButton}" Command="{Binding DataContext.OpenOfficialSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" HorizontalAlignment="Left" Margin="0,8,0,0">
                              <TextBlock Text="Abrir suporte oficial ASUS" />
                            </Button>
                          </StackPanel>
                        </Border>
                      </Grid>

                      <TextBlock Text="{Binding MatchStatus}" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" />
                      <TextBlock Text="{Binding Candidate.ArchiveIntegritySummary}" FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" />
                      <TextBlock FontSize="9" Foreground="#666666" TextWrapping="Wrap" Margin="0,4,0,0">
                        <Run Text="SHA-256 publicado: " /><Run Text="{Binding Candidate.PublishedArchiveSha256, TargetNullValue='não publicado'}" />
                      </TextBlock>
                      <TextBlock FontSize="9" Foreground="#666666" TextWrapping="Wrap" Margin="0,3,0,0">
                        <Run Text="SHA-256 calculado no arquivo revisado: " /><Run Text="{Binding Candidate.ReviewedArchiveSha256}" />
                      </TextBlock>
                      <TextBlock Text="{Binding Candidate.CatalogSignatureSummary}" FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" />
                      <TextBlock Text="{Binding Candidate.InfMembershipSummary}" FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0" />
                      <TextBlock FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0">
                        <Run Text="INF: " /><Run Text="{Binding Candidate.InfName}" /><Run Text=" · seção " /><Run Text="{Binding Candidate.InfArchitectureSection}" />
                      </TextBlock>
                      <TextBlock Text="{Binding Candidate.OsCompatibilitySummary}" FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0" />
                      <Border Background="#F7F7F5" CornerRadius="7" Padding="10" Margin="0,9,0,0">
                        <StackPanel>
                          <TextBlock Text="PENDÊNCIAS E LIMITE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                          <TextBlock Text="{Binding Candidate.PendingItems}" FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0" />
                          <TextBlock Text="Instalação assistida indisponível. Nenhum instalador foi executado." FontSize="10" FontWeight="SemiBold" Foreground="#333333" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,12"
                    Visibility="{Binding HasPackageAnalysisSummary, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="ANÁLISE GENÉRICA DO PACOTE LOCAL" FontSize="10" FontWeight="Bold" Foreground="#555555" />
                <TextBlock Text="{Binding PackageAnalysisSummary}" FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="{Binding PackageImportFeedback}" FontSize="10" Foreground="#333333" TextWrapping="Wrap" Margin="0,5,0,0" />
              </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding LocalPackageCandidates}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding InfName}" FontSize="13" FontWeight="Bold" />
                          <TextBlock FontSize="10" Foreground="#666666" Margin="0,3,0,0">
                            <Run Text="Provider: " /><Run Text="{Binding Provider, TargetNullValue='não informado'}" />
                            <Run Text=" · DriverVer: " /><Run Text="{Binding DriverVersion, TargetNullValue='não informado'}" />
                          </TextBlock>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#F1F1EF" CornerRadius="6" Padding="9,6" VerticalAlignment="Center">
                          <TextBlock Text="{Binding OutcomeLabel}" FontSize="9" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="260" />
                        </Border>
                      </Grid>
                      <TextBlock Text="{Binding TargetSummary}" FontSize="10" FontWeight="SemiBold" Foreground="#333333" TextWrapping="Wrap" Margin="0,8,0,0" />
                      <TextBlock FontSize="9" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0">
                        <Run Text="Catálogo: " /><Run Text="{Binding CatalogName, TargetNullValue='não informado'}" />
                        <Run Text=" · assinatura/membership: " /><Run Text="{Binding SignatureStatusLabel}" />
                        <Run Text=" · signatário: " /><Run Text="{Binding CatalogSigner, TargetNullValue='não retornado'}" />
                      </TextBlock>
                      <TextBlock FontSize="9" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0">
                        <Run Text="Arquivos necessários encontrados e verificados: " /><Run Text="{Binding RequiredPackageFiles.Count}" />
                        <Run Text=" · INF SHA-256: " /><Run Text="{Binding InfSha256, TargetNullValue='indisponível'}" />
                      </TextBlock>
                      <TextBlock FontSize="9" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0">
                        <Run Text="DDInstall aplicável: " /><Run Text="{Binding ApplicableInstallSectionsSummary}" />
                      </TextBlock>
                      <TextBlock Text="{Binding DependencyResolutionSummary}" FontSize="9" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0" />
                      <TextBlock Text="{Binding ReasonsSummary}" FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,7,0,0" />
                      <Button Style="{StaticResource QuietButton}"
                              Command="{Binding DataContext.PreparePackageInstallPreviewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              CommandParameter="{Binding}" IsEnabled="{Binding CanPrepareInstallation}" HorizontalAlignment="Left" Margin="0,9,0,0">
                        <TextBlock Text="Preparar prévia para este dispositivo" />
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="#F7F7F5" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,14"
                    Visibility="{Binding HasSelectedPackageReview, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="PRÉVIA DE INSTALAÇÃO — AINDA NÃO APLICADA" FontSize="11" FontWeight="Bold" Foreground="#222222" />
                <TextBlock FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,7,0,0">
                  <Run Text="Dispositivo-alvo: " /><Run Text="{Binding SelectedPackageReviewTarget, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0">
                  <Run Text="Driver atual: " /><Run Text="{Binding SelectedPackageReviewCurrentDriver, Mode=OneWay}" />
                </TextBlock>
                <TextBlock FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0">
                  <Run Text="Pacote pretendido: " /><Run Text="{Binding SelectedPackageReviewPackage, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding SelectedPackageReview.PossibleImpact}" FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,7,0,0" />
                <TextBlock Text="{Binding SelectedPackageReview.RequiredPermissions}" FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,5,0,0" />
                <TextBlock Text="{Binding SelectedPackageReview.RecoveryLimits}" FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,5,0,0" />
                <Border Background="#FFF7E8" BorderBrush="#E8D4AD" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,7,0,0">
                  <StackPanel>
                    <TextBlock Text="ALCANCE DA ASSOCIAÇÃO" FontSize="9" FontWeight="Bold" Foreground="#6A4C17" />
                    <TextBlock Text="{Binding SelectedPackageReview.InstallationReach}" FontSize="10" Foreground="#5C4A2A" TextWrapping="Wrap" Margin="0,4,0,0" />
                  </StackPanel>
                </Border>
                <CheckBox Content="Li e aceito as consequências desta prévia específica. Isto não autoriza a instalação real."
                          IsChecked="{Binding DriverInstallConsequencesAccepted, Mode=TwoWay}" FontSize="10" Foreground="#333333" Margin="0,10,0,0" />
                <Button Style="{StaticResource QuietButton}" Command="{Binding RecordPackageInstallConsentAndCaptureCommand}"
                        IsEnabled="{Binding CanRecordPackageInstallConsentAndCapture}" HorizontalAlignment="Left" Margin="0,8,0,0">
                  <TextBlock Text="Registrar consentimento e captura no histórico" />
                </Button>
                <TextBlock Text="Instalação real BLOQUEADA nesta etapa. Nenhuma alteração de driver é executada; o consentimento e a captura apenas registram o estado revisado." FontSize="10" FontWeight="Bold" Foreground="#842525" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Text="{Binding InstallCaptureFeedback}" FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,5,0,0"
                           Visibility="{Binding HasInstallCaptureFeedback, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
