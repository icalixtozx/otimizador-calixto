<UserControl x:Class="Optimizer.App.Views.ProcessesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Canvas}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="34,28,34,31">
      <Grid Margin="0,0,0,17">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Processos e prioridade" FontSize="27" FontWeight="Bold" />
          <TextBlock Text="Leia processos e prepare uma revisão individual de prioridade." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,7,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource QuietButton}" Command="{Binding RefreshCommand}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="↻" FontSize="16" Margin="0,0,6,0" />
            <TextBlock Text="Atualizar processos" />
          </StackPanel>
        </Button>
      </Grid>

      <Border Background="#111111" CornerRadius="11" Padding="15,13" Margin="0,0,0,15">
        <StackPanel>
          <TextBlock Text="MUTAÇÃO REAL BLOQUEADA NESTA VERSÃO" Foreground="White" FontSize="10" FontWeight="Bold" />
          <TextBlock Text="Esta tela consulta e registra revisão/captura. Não chama setters de prioridade. Consentimento de consequência não é autorização para escrever. Nenhuma alteração em massa ou prioridade Tempo real está disponível." Foreground="#D6D6D6" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource CardBorder}" Padding="13,11" Margin="0,0,0,13">
        <TextBlock Text="{Binding StatusMessage}" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" />
      </Border>

      <Grid Margin="0,0,0,9">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Processos detectados" FontSize="17" FontWeight="Bold" />
          <TextBlock Text="A seleção é vinculada a PID, instante de criação e caminho quando acessível. Nome sozinho não identifica um alvo." FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,15,0" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="SOMENTE LEITURA" FontSize="9" FontWeight="Bold" Foreground="#555555" VerticalAlignment="Center" />
      </Grid>

      <Border Style="{StaticResource CardBorder}" Padding="0" Margin="0,0,0,16">
        <DataGrid ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  MaxHeight="340" MinHeight="120" Background="White" BorderThickness="0"
                  RowBackground="White" AlternatingRowBackground="#FAFAF9" FontSize="10">
          <DataGrid.Columns>
            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="65" />
            <DataGridTextColumn Header="PROCESSO" Binding="{Binding Name}" Width="145" />
            <DataGridTextColumn Header="ESTADO" Binding="{Binding Status}" Width="125" />
            <DataGridTextColumn Header="PRIORIDADE" Binding="{Binding Priority}" Width="120" />
            <DataGridTextColumn Header="CRIADO" Binding="{Binding Created}" Width="135" />
            <DataGridTextColumn Header="CAMINHO (SE ACESSÍVEL)" Binding="{Binding Path}" Width="*" MinWidth="180" />
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Revisão individual" FontSize="17" FontWeight="Bold" />
          <TextBlock Text="O plano é atualizado por leitura real antes de registrar a captura." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,12" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" ItemsSource="{Binding TargetPriorities}" DisplayMemberPath="Label" SelectedValuePath="Value"
                      SelectedValue="{Binding SelectedTargetPriority, Mode=TwoWay}"
                      Height="35" VerticalContentAlignment="Center" Margin="0,0,9,0" />
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding PrepareReviewCommand}" Margin="0,0,8,0">
              <TextBlock Text="Revisar estado atual" />
            </Button>
            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Command="{Binding CaptureCommand}">
              <TextBlock Text="Registrar consentimento e captura" />
            </Button>
          </Grid>
          <Border Background="#F5F5F3" CornerRadius="9" Padding="13" Margin="0,12,0,0" Visibility="{Binding HasReview, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
              <TextBlock Text="PRÉVIA BASEADA NO ESTADO REAL" FontSize="9" FontWeight="Bold" Foreground="#555555" />
              <TextBlock Text="{Binding ReviewSummary}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0" />
              <TextBlock Text="{Binding ReviewCompatibility}" FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,5,0,0" />
              <TextBlock Text="{Binding ReviewConsequence}" FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,7,0,0" />
              <CheckBox Content="Li e aceito registrar esta consequência no plano" IsChecked="{Binding ConsequencesAccepted, Mode=TwoWay}"
                        FontSize="10" Margin="0,10,0,0" />
              <TextBlock Text="{Binding CaptureNotice}" FontSize="9" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" />
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding ResultMessage}" FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
      </Border>

      <Grid Margin="0,0,0,9">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Histórico do motor" FontSize="17" FontWeight="Bold" />
          <TextBlock Text="Os registros usam o diário local comum do aplicativo. Snapshot não é backup do Windows." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource QuietButton}" Command="{Binding RefreshHistoryCommand}" Content="Atualizar histórico" />
      </Grid>
      <ItemsControl ItemsSource="{Binding History}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,9">
              <StackPanel>
                <TextBlock Text="{Binding State}" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="{Binding Date}" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                <TextBlock Text="{Binding Event}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="{Binding Recovery}" FontSize="9" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="Ainda não há registros deste módulo." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,12">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding History.Count}" Value="0">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </StackPanel>
  </ScrollViewer>
</UserControl>
