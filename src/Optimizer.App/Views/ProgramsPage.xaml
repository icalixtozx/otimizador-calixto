<UserControl x:Class="Optimizer.App.Views.ProgramsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Canvas}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="34,28,34,31">
      <Grid Margin="0,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Programas pós-formatação" FontSize="27" FontWeight="Bold" />
          <TextBlock Text="Selecione vários pacotes do catálogo revisado, confira a operação e veja o que foi identificado localmente." FontSize="12" Foreground="#737373" Margin="0,7,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource QuietButton}" Command="{Binding RefreshInstalledCommand}" VerticalAlignment="Center">
          <TextBlock Text="Ler programas instalados" />
        </Button>
      </Grid>

      <Border Style="{StaticResource CardBorder}" Padding="15,12" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding InventoryWarning}" Visibility="{Binding HasInventoryWarning, Converter={StaticResource BoolToVisibility}}" FontSize="10" Foreground="#8A4B16" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
      </Border>

      <Border Background="#FFF7E8" CornerRadius="10" Padding="14" Margin="0,0,0,12">
        <TextBlock Text="{Binding WinGetSourceStatusMessage}" FontSize="10" Foreground="#604B28" TextWrapping="Wrap" />
      </Border>

      <Border Background="#F1F1EF" CornerRadius="10" Padding="14" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="EXECUÇÃO REAL BLOQUEADA NESTA ENTREGA" FontSize="10" FontWeight="Bold" Foreground="#6F2828" />
          <TextBlock Text="Esta página não instala o WinGet nem programas. O botão de leitura consulta somente as entradas locais de Programas e Recursos. Uma correspondência ausente ou ambígua não é apresentada como certeza de que o programa está instalado ou ausente." FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>
      </Border>

      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Catálogo inicial verificado" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding SelectionSummary}" FontSize="10" Foreground="#666666" VerticalAlignment="Center" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Packages}" Margin="0,0,0,18">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,3,13,0" />
                <StackPanel Grid.Column="1">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="Bold" />
                    <TextBlock Text="  ·  " FontSize="12" Foreground="#888888" />
                    <TextBlock Text="{Binding Publisher}" FontSize="11" Foreground="#666666" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock Text="{Binding PackageId}" FontSize="10" FontFamily="Consolas" Foreground="#555555" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding SourceLabel}" FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,5,0,0" />
                  <TextBlock Text="{Binding LicenseLabel}" FontSize="9" Foreground="#777777" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding InstalledLabel}" FontSize="10" FontWeight="SemiBold" Margin="0,8,0,0" />
                  <TextBlock Text="{Binding InstalledDetails}" FontSize="9" Foreground="#777777" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="CATÁLOGO" FontSize="8" FontWeight="Bold" Foreground="#555555" VerticalAlignment="Top" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Revisão da operação" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding CheckBlockedStatusCommand}" Margin="0,0,0,0">
          <TextBlock Text="Verificar bloqueio por pacote" />
        </Button>
      </Grid>
      <ItemsControl ItemsSource="{Binding Reviews}" Margin="0,0,0,12">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Bold" />
                <TextBlock Text="{Binding PackageId}" FontSize="9" FontFamily="Consolas" Foreground="#555555" Margin="0,3,0,0" />
                <TextBlock FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,8,0,0"><Run Text="Origem: " /><Run Text="{Binding Source}" /></TextBlock>
                <TextBlock FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,5,0,0"><Run Text="Ação pretendida: " /><Run Text="{Binding Action}" /></TextBlock>
                <TextBlock FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,5,0,0"><Run Text="Escopo: " /><Run Text="{Binding Scope}" /></TextBlock>
                <TextBlock FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,5,0,0"><Run Text="Acordos: " /><Run Text="{Binding Agreements}" /></TextBlock>
                <TextBlock Text="{Binding Permissions}" FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,5,0,0" />
                <TextBlock FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,5,0,0"><Run Text="Reinício: " /><Run Text="{Binding Restart}" /></TextBlock>
                <Border Background="#FFF7E8" CornerRadius="7" Padding="10" Margin="0,8,0,0">
                  <TextBlock Text="{Binding ManifestCaution}" FontSize="9" Foreground="#604B28" TextWrapping="Wrap" />
                </Border>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Background="#F0F0EE" CornerRadius="8" Padding="13" Margin="0,0,0,18" Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="Marque um ou mais programas para montar a revisão. Seleção e revisão não constituem autorização de instalação." FontSize="10" Foreground="#666666" />
      </Border>

      <TextBlock Text="Resultados por pacote" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" />
      <ItemsControl ItemsSource="{Binding Results}" Margin="0,0,0,12">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource CardBorder}" Padding="13" Margin="0,0,0,8">
              <StackPanel>
                <TextBlock Text="{Binding PackageId}" FontSize="10" FontWeight="Bold" />
                <TextBlock Text="{Binding Outcome}" FontSize="9" Foreground="#6F2828" Margin="0,3,0,0" />
                <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="#555555" TextWrapping="Wrap" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border Background="#F0F0EE" CornerRadius="8" Padding="13" Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="Nenhum resultado de instalação nesta sessão. Os resultados simulados do harness não são mostrados como instalação real." FontSize="10" Foreground="#666666" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
