<Window x:Class="Optimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Optimizer.App.ViewModels"
        xmlns:views="clr-namespace:Optimizer.App.Views"
        Title="Calixto Optimizer" Width="1480" Height="920"
        MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Canvas}"
        FontFamily="Segoe UI">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:OverviewPageViewModel}">
      <views:OverviewPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DriversPageViewModel}">
      <views:DriversPage />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProfilesPageViewModel}">
      <views:ProfilesPage />
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="238" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#111111">
      <Grid Margin="17,20,17,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="32" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,2,0,0">
          <Border Width="34" Height="34" CornerRadius="10" Background="White" VerticalAlignment="Center">
            <TextBlock Text="C" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="CALIXTO" Foreground="White" FontSize="14" FontWeight="Bold" />
            <TextBlock Text="OPTIMIZER" Foreground="#8D8D8D" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0" />
          </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="ESPAÇO DE TRABALHO" Foreground="#686868" FontSize="10"
                   FontWeight="Bold" Margin="9,0,0,9" />

        <ItemsControl Grid.Row="3" ItemsSource="{Binding NavigationItems}" Margin="0,0,0,12">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource NavItemButton}"
                      Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                      CommandParameter="{Binding Key}" IsEnabled="{Binding IsAvailable}"
                      ToolTip="{Binding Badge}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="27" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Symbol}" FontSize="16" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                             VerticalAlignment="Center" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="9,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"
                             Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                  <TextBlock Grid.Column="2" Text="{Binding Badge}" FontSize="9" Foreground="#777777" VerticalAlignment="Center"
                             Visibility="{Binding Badge, Converter={StaticResource StringToVisibilityConverter}}" />
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="4" Background="#1B1B1B" BorderBrush="#2B2B2B" BorderThickness="1" CornerRadius="11" Padding="12">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" Fill="#F2F2F2" VerticalAlignment="Center" />
              <TextBlock Text=" SOMENTE LEITURA" Foreground="#E1E1E1" FontSize="9" FontWeight="Bold" />
            </StackPanel>
            <TextBlock Text="Esta versão identifica seu sistema. Nenhum ajuste é aplicado." Foreground="#8A8A8A"
                       FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="15" />
            <TextBlock Text="v0.5.0 · Experimental" Foreground="#656565" FontSize="9" Margin="0,11,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="68" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="White" BorderBrush="#E7E7E4" BorderThickness="0,0,0,1">
        <Grid Margin="34,0,34,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding PageTitle}" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="  /  Calixto Optimizer" Foreground="#888888" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
          <Border Grid.Column="1" Background="#F5F5F3" CornerRadius="7" Padding="10,6" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="6" Height="6" Fill="#111111" VerticalAlignment="Center" />
              <TextBlock Text="  LOCAL · PRIVADO" FontSize="9" FontWeight="Bold" Foreground="#555555" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
    </Grid>
  </Grid>
</Window>
